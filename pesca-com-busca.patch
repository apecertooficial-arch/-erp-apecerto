index 0000000..a812194
--- /dev/null
+++ b/supabase/migrations/20260813160300_funil_2_busca_no_aquario_para_pescar.sql
@@ -0,0 +1,70 @@
+-- BUSCA NO AQUARIO PARA PESCAR (ago/2026)
+--
+-- O modal de pesca mostrava f2_listar_aquario(): os 20 mais antigos, sempre os
+-- mesmos, num <select> sem busca. So que o Aquario tem 11.669 negocios
+-- disponiveis. Na pratica o corretor nunca conseguia pescar QUEM ele queria --
+-- so os mesmos 20 nomes que ele ja tinha decidido nao pescar.
+--
+-- Esta funcao repete exatamente o criterio de f2_pescar_negocio (negocio aberto
+-- no estagio Aquario, sem corretor no negocio E no lead, sem card no funil) e
+-- acrescenta busca por nome ou telefone. Manter o criterio identico e o que
+-- impede a lista de oferecer lead que a pesca depois recusa.
+--
+-- 'disponiveis' volta em toda linha (count sobre o conjunto filtrado, antes do
+-- limite) para a tela poder dizer quantos existem alem dos que ela mostra.
+
+create or replace function public.f2_aquario_buscar(p_busca text default null, p_limite int default 30)
+returns table (
+  negocio_id bigint,
+  lead_id bigint,
+  nome text,
+  telefone text,
+  criado_em timestamptz,
+  disponiveis bigint
+)
+language sql
+stable
+security definer
+set search_path to ''
+as $$
+  with termo as (
+    -- nome OU telefone; no telefone so os digitos importam, porque o corretor
+    -- digita com mascara e o banco guarda cru (ou o contrario)
+    select nullif(btrim(coalesce(p_busca, '')), '') as texto,
+           nullif(regexp_replace(coalesce(p_busca, ''), '\D', '', 'g'), '') as digitos
+  ),
+  base as (
+    select n.id as negocio_id, l.id as lead_id, l.nome, l.telefone, n.criado_em,
+           t.texto as termo_texto
+      from public.negocios n
+      join public.leads l on l.id = n.lead_id
+      cross join termo t
+     where (select auth.uid()) is not null
+       and (public.f2_admin() or public.f2_corretor_atual() is not null)
+       and n.stage_id = public.aquario_stage_id()
+       and n.status = 'aberto'
+       and n.corretor_id is null
+       and l.corretor_id is null
+       and not exists (select 1 from public.f2_lead f where f.origem_negocio_id = n.id)
+       and (
+         t.texto is null
+         or l.nome ilike '%' || t.texto || '%'
+         or (t.digitos is not null
+             and regexp_replace(coalesce(l.telefone,''), '\D', '', 'g') like '%' || t.digitos || '%')
+       )
+  )
+  select b.negocio_id, b.lead_id, b.nome, b.telefone, b.criado_em,
+         count(*) over () as disponiveis
+    from base b
+   -- sem busca, os mais antigos primeiro (agua parada ha mais tempo);
+   -- com busca, ordem alfabetica, que e como se procura um nome
+   order by case when b.termo_texto is null then 0 else 1 end,
+            case when b.termo_texto is null then b.criado_em end asc,
+            case when b.termo_texto is not null then b.nome end asc
+   limit greatest(1, least(coalesce(p_limite, 30), 100));
+$$;
+
+comment on function public.f2_aquario_buscar(text, int) is
+  'Leads disponiveis no Aquario para pesca, com busca por nome ou telefone. Criterio identico ao de f2_pescar_negocio, para a lista nunca oferecer o que a pesca recusa.';
+
+grant execute on function public.f2_aquario_buscar(text, int) to authenticated;
