diff --git a/supabase/migrations/20260813170000_carga_de_leads_agendada.sql b/supabase/migrations/20260813170000_carga_de_leads_agendada.sql
new file mode 100644
index 0000000..5212ef0
--- /dev/null
+++ b/supabase/migrations/20260813170000_carga_de_leads_agendada.sql
@@ -0,0 +1,114 @@
+-- CARGA AGENDADA DE LEADS DE PLANILHA (ago/2026)
+--
+-- 300 leads de planilha do Meta, entregues ate sexta, so dentro da janela
+-- oficial (09:30-18:30, dias uteis), obedecendo INTEIRAMENTE a automacao
+-- publicada -- a mesma que distribui lead de anuncio.
+--
+-- O QUE A CARGA *NAO* DECIDE: quem recebe, com que peso, se exige presenca e em
+-- que etapa o lead cai. Tudo isso continua sendo do bloco de distribuicao da
+-- automacao. A carga so decide QUANDO cada lead entra na fila. Foi decisao
+-- explicita do Romulo: "quero seguir a regra da automacao; se esta desmarcado
+-- foi porque eu desmarquei, e quando eu quiser eu marco de volta".
+--
+-- DUPLICADO NAO DUPLICA: telefone que ja existe reaproveita o registro do lead,
+-- nunca cria um segundo. Lead que ja tem dono ou card vivo no Funil 2.0 nao
+-- entra na carga -- fica 'pulado', com o dono atual no relatorio. Mexer na
+-- carteira de quem ja atende nao e o que esta carga se propoe a fazer.
+--
+-- RITMO ESPALHADO: f2_carga_agendar divide as linhas por igual entre todos os
+-- minutos uteis da janela. 300 leads em 4 dias dao um a cada 7 minutos. Sem
+-- rajada, sem fila represada no fim do dia.
+
+create table if not exists public.f2_carga_lead (
+  id            bigserial primary key,
+  lote          text not null,
+  linha         int,
+  nome          text not null,
+  telefone      text not null,
+  telefone_dig  text generated always as (regexp_replace(coalesce(telefone,''), '\D', '', 'g')) stored,
+  email         text,
+  origem        text,
+  extras        jsonb not null default '{}'::jsonb,
+  quando        timestamptz,
+  distribuido_em timestamptz,
+  lead_id       bigint,
+  negocio_id    bigint,
+  corretor_id   bigint,
+  corretor_nome text,
+  situacao      text not null default 'pendente',
+  motivo        text,
+  criado_em     timestamptz not null default now()
+);
+
+create index if not exists f2_carga_lead_fila
+  on public.f2_carga_lead (lote, distribuido_em, quando)
+  where distribuido_em is null;
+create index if not exists f2_carga_lead_tel on public.f2_carga_lead (telefone_dig);
+
+comment on table public.f2_carga_lead is
+  'Fila de leads de planilha para distribuicao agendada. Uma linha por lead; quando = horario programado; situacao = pendente|distribuido|pulado|erro.';
+
+alter table public.f2_carga_lead enable row level security;
+
+drop policy if exists f2_carga_lead_gestao on public.f2_carga_lead;
+create policy f2_carga_lead_gestao on public.f2_carga_lead
+  for select to authenticated using (public.f2_admin());
+
+create or replace function public.f2_carga_agendar(p_lote text, p_de timestamptz default now(), p_ate timestamptz default null)
+returns jsonb language plpgsql security definer set search_path to 'public'
+as $function$
+declare v_tz text; v_h1 time; v_h2 time; v_min int; v_linhas int; v_ate timestamptz;
+begin
+  select timezone, horario_oficial_inicio, horario_oficial_fim
+    into v_tz, v_h1, v_h2 from ncrm_operacao_config where id;
+  v_ate := coalesce(p_ate, p_de + interval '7 days');
+
+  select count(*) into v_linhas from f2_carga_lead
+   where lote = p_lote and distribuido_em is null and situacao = 'pendente';
+  if v_linhas = 0 then return jsonb_build_object('ok', false, 'erro', 'lote_sem_linhas_pendentes'); end if;
+
+  create temporary table if not exists _minutos_uteis (k int, m timestamptz) on commit drop;
+  delete from _minutos_uteis;
+
+  insert into _minutos_uteis (k, m)
+  select row_number() over (order by g), g
+    from generate_series(date_trunc('minute', p_de), v_ate, interval '1 minute') g
+   where (g at time zone v_tz)::time >= v_h1
+     and (g at time zone v_tz)::time <  v_h2
+     and extract(isodow from (g at time zone v_tz)) between 1 and 5;
+
+  select count(*) into v_min from _minutos_uteis;
+  if v_min = 0 then return jsonb_build_object('ok', false, 'erro', 'sem_minutos_uteis_no_intervalo'); end if;
+
+  -- espalha por igual: a linha i cai no minuto do ponto medio da sua fatia,
+  -- para nao amontoar no comeco nem no fim
+  with pend as (
+    select id, row_number() over (order by coalesce(linha, id), id) as rn, count(*) over () as total
+      from f2_carga_lead
+     where lote = p_lote and distribuido_em is null and situacao = 'pendente'
+  ), alvo as (
+    select p.id, greatest(1, least(v_min, ceil((p.rn - 0.5) * v_min / p.total)::int)) as k
+      from pend p
+  )
+  update f2_carga_lead c
+     set quando = d.m + make_interval(secs => floor(random() * 60)::int)
+    from alvo a join _minutos_uteis d on d.k = a.k
+   where c.id = a.id;
+
+  return jsonb_build_object('ok', true, 'lote', p_lote, 'linhas', v_linhas,
+    'minutos_uteis_disponiveis', v_min,
+    'primeiro', (select min(quando) from f2_carga_lead where lote = p_lote and distribuido_em is null),
+    'ultimo',   (select max(quando) from f2_carga_lead where lote = p_lote and distribuido_em is null),
+    'intervalo_medio_min', round(v_min::numeric / v_linhas, 1));
+end $function$;
+
+comment on function public.f2_carga_agendar(text, timestamptz, timestamptz) is
+  'Espalha as linhas pendentes de um lote por igual entre os minutos uteis da janela oficial no intervalo dado.';
+
+revoke execute on function public.f2_carga_agendar(text, timestamptz, timestamptz) from public, anon;
+
+create or replace view public.f2_carga_resumo as
+  select lote, situacao, count(*) as leads,
+         min(quando) as primeiro_agendado, max(quando) as ultimo_agendado,
+         min(distribuido_em) as primeiro_feito, max(distribuido_em) as ultimo_feito
+    from public.f2_carga_lead group by lote, situacao;
diff --git a/supabase/migrations/20260813170100_carga_de_leads_tick_obedece_a_automacao.sql b/supabase/migrations/20260813170100_carga_de_leads_tick_obedece_a_automacao.sql
new file mode 100644
index 0000000..21fa4d9
--- /dev/null
+++ b/supabase/migrations/20260813170100_carga_de_leads_tick_obedece_a_automacao.sql
@@ -0,0 +1,148 @@
+-- O TICK DA CARGA: pega o que ja venceu e entrega, um a um.
+--
+-- Roda de minuto em minuto. O teto por rodada existe para que um atraso
+-- acumulado (banco parado, janela fechada) nao vire rajada de 50 leads no mesmo
+-- minuto -- ele repoe rapido, mas nao de uma vez.
+--
+-- A FILA E A DA AUTOMACAO, SEM EXCECAO. motor_proximo_sequencial e a mesma
+-- funcao que o lead de anuncio usa: le quem esta marcado no bloco, os pesos e a
+-- exigencia de presenca, tudo direto da automacao publicada. Marcar ou
+-- desmarcar corretor na tela muda a carga na hora, sem tocar em codigo.
+--
+-- SEM NINGUEM APTO, O LEAD ESPERA -- e nao vira erro. Ele continua pendente e
+-- sai no primeiro minuto em que alguem estiver apto. A carga se reprograma
+-- sozinha; se sobrar coisa na sexta, sobra, e o relatorio mostra quanto.
+--
+-- DESTINO: etapa 'novo' / Primeira abordagem, que e o que o bloco de Acao da
+-- automacao faz (Criar negocio -> Funil 2.0 -> Novo). Nao e o Pescado: pescar e
+-- ato do corretor, isto aqui e entrega da gestao.
+
+create or replace function public.f2_carga_tick(p_teto int default 6)
+returns jsonb language plpgsql security definer set search_path to 'public'
+as $function$
+declare
+  r record; v_auto bigint; v_bloco text;
+  v_lead bigint; v_neg bigint; v_cor bigint; v_nome text; v_card uuid;
+  v_tz text; v_h1 time; v_h2 time;
+  v_feitos int := 0; v_pulados int := 0; v_esperando int := 0;
+begin
+  select timezone, horario_oficial_inicio, horario_oficial_fim
+    into v_tz, v_h1, v_h2 from ncrm_operacao_config where id;
+  if not ((now() at time zone v_tz)::time >= v_h1 and (now() at time zone v_tz)::time < v_h2) then
+    return jsonb_build_object('ok', true, 'acao', 'fora da janela oficial');
+  end if;
+
+  select me.automacao_id, me.bloco_id into v_auto, v_bloco
+    from motor_execucoes me
+   where me.evento = 'distribuicao' and me.automacao_id is not null
+     and exists (select 1 from motor_roleta_contadores rc
+                  where rc.automacao_id = me.automacao_id and rc.bloco_id = me.bloco_id)
+   order by me.criado_em desc limit 1;
+  if v_auto is null then
+    return jsonb_build_object('ok', false, 'erro', 'sem_fila_configurada');
+  end if;
+
+  for r in
+    select * from f2_carga_lead
+     where distribuido_em is null and situacao = 'pendente'
+       and quando is not null and quando <= now()
+     order by quando, id
+     limit greatest(1, least(coalesce(p_teto, 6), 30))
+  loop
+    v_lead := null; v_neg := null; v_card := null;
+
+    -- DUPLICADO NAO DUPLICA: reaproveita o registro pelos 8 ultimos digitos, o
+    -- mesmo criterio que o resto do sistema usa para telefone (resolve DDI, DDD
+    -- e o nono digito de uma vez).
+    if length(r.telefone_dig) >= 8 then
+      select l.id into v_lead from leads l
+       where right(regexp_replace(coalesce(l.telefone,''), '\D', '', 'g'), 8) = right(r.telefone_dig, 8)
+       order by l.id desc limit 1;
+    end if;
+
+    -- JA TEM DONO OU JA ESTA NO FUNIL: fica de fora. A protecao do bloco
+    -- devolveria ao rodizio quem nao esta em venda/visita, mas mexer na
+    -- carteira de quem ja atende nao e o proposito desta carga.
+    if v_lead is not null and (
+         exists (select 1 from leads l where l.id = v_lead and l.corretor_id is not null)
+      or exists (select 1 from f2_lead f join negocios n on n.id = f.origem_negocio_id
+                  where n.lead_id = v_lead and f.descartado_em is null)
+    ) then
+      update f2_carga_lead
+         set situacao = 'pulado', distribuido_em = now(), lead_id = v_lead,
+             motivo = 'ja tem dono ou card ativo no Funil 2.0',
+             corretor_nome = (select c.nome from leads l join corretores c on c.id = l.corretor_id where l.id = v_lead)
+       where id = r.id;
+      v_pulados := v_pulados + 1;
+      continue;
+    end if;
+
+    v_cor := motor_proximo_sequencial(v_auto, v_bloco);
+    if v_cor is null then
+      v_esperando := v_esperando + 1;
+      continue;
+    end if;
+    select nome into v_nome from corretores where id = v_cor;
+
+    if v_lead is null then
+      insert into leads (nome, telefone, email, origem, status, extras)
+      values (r.nome, r.telefone_dig, nullif(r.email,''), coalesce(r.origem, 'planilha'), 'novo',
+              coalesce(r.extras, '{}'::jsonb))
+      returning id into v_lead;
+    end if;
+
+    -- NEGOCIO no Funil 2.0: reaproveita aberto antes de criar. O negocio antigo
+    -- do Aquario, se houver, tambem recebe o dono -- senao o lead continuaria
+    -- aparecendo como disponivel para pesca depois de ja ter sido entregue.
+    select n.id into v_neg from negocios n
+     where n.lead_id = v_lead and n.pipeline_id = f2_pipeline_id() and n.status = 'aberto'
+     order by n.id desc limit 1;
+    if v_neg is null then
+      insert into negocios (lead_id, pipeline_id, stage_id, status, ultima_movimentacao, criado_em)
+      values (v_lead, f2_pipeline_id(),
+              (select s.id from pipeline_stages s where s.pipeline_id = f2_pipeline_id()
+                order by s.ordem nulls last, s.id limit 1),
+              'aberto', now(), now())
+      returning id into v_neg;
+    end if;
+
+    update leads    set corretor_id = v_cor where id = v_lead;
+    update negocios set corretor_id = v_cor where lead_id = v_lead and corretor_id is null;
+
+    -- O selo de aquario sai junto com a posse, como na pesca.
+    update leads
+       set tags = coalesce((select jsonb_agg(t) from jsonb_array_elements(tags) t
+                             where t->>'name' is distinct from 'Aquário'), '[]'::jsonb)
+     where id = v_lead and tags @> '[{"name":"Aquário"}]'::jsonb;
+
+    v_card := f2_entrada_direta(v_neg, 'novo');
+
+    insert into lead_dono_auditoria(lead_id, de, para, origem, quando)
+    values (v_lead, null, v_cor, 'carga_planilha:' || r.lote, now());
+
+    insert into motor_execucoes(automacao_id, automacao_nome, bloco_id, evento, status,
+                                lead_nome, lead_telefone, detalhe)
+    values (v_auto, 'Carga de planilha ' || r.lote, v_bloco, 'distribuicao',
+            case when v_card is null then 'alerta' else 'ok' end, r.nome, r.telefone_dig,
+            case when v_card is null
+                 then 'Lead da carga entregue a ' || coalesce(v_nome,'?') || ' — ATENCAO: card do Funil 2.0 nao foi criado'
+                 else 'Lead da carga entregue a ' || coalesce(v_nome,'?') || ' e card criado no Funil 2.0' end);
+
+    update f2_carga_lead
+       set situacao = 'distribuido', distribuido_em = now(),
+           lead_id = v_lead, negocio_id = v_neg, corretor_id = v_cor, corretor_nome = v_nome
+     where id = r.id;
+    v_feitos := v_feitos + 1;
+  end loop;
+
+  return jsonb_build_object('ok', true, 'distribuidos', v_feitos,
+                            'pulados', v_pulados, 'esperando_corretor_apto', v_esperando);
+end $function$;
+
+comment on function public.f2_carga_tick(int) is
+  'Distribui os leads da carga que ja venceram, pela fila da automacao publicada (marcados, pesos e exigencia de presenca). Sem ninguem apto, o lead espera. Destino: etapa novo / Primeira abordagem.';
+
+revoke execute on function public.f2_carga_tick(int) from public, anon;
+
+select cron.schedule('f2-carga-planilha', '* * * * *', 'select public.f2_carga_tick(6);')
+ where not exists (select 1 from cron.job where jobname = 'f2-carga-planilha');
diff --git a/supabase/migrations/20260813170200_carga_pula_corretor_que_ja_falou.sql b/supabase/migrations/20260813170200_carga_pula_corretor_que_ja_falou.sql
new file mode 100644
index 0000000..efdec63
--- /dev/null
+++ b/supabase/migrations/20260813170200_carga_pula_corretor_que_ja_falou.sql
@@ -0,0 +1,109 @@
+-- QUEM JA FALOU COM O CLIENTE NAO RECEBE ELE DE NOVO (ago/2026)
+--
+-- Boa parte da carga sao leads de anuncio de junho/julho que ja passaram por
+-- alguem: dos 299 pendentes, 139 tem conversa de WhatsApp com algum corretor.
+-- Entregar o cliente para a mesma pessoa que ja tentou e nao emplacou repete a
+-- mesma abordagem e o mesmo resultado. A regra manda o lead para uma voz nova.
+--
+-- NUNCA TRAVA O LEAD. Se todos os aptos ja falaram com o cliente, a exclusao e
+-- ignorada e a fila normal decide -- e o motivo fica registrado. Preferir um
+-- segundo contato do mesmo corretor a nenhum contato e o certo; hoje nenhum
+-- lead da carga chegou nessa situacao (maximo de 2 corretores por cliente,
+-- contra 4 na fila).
+--
+-- ESCOPO: so a carga de planilha. A distribuicao normal de lead de anuncio
+-- continua como esta.
+
+create or replace function public.f2_corretores_com_historico(p_telefone text)
+returns setof bigint
+language sql stable security definer set search_path to 'public'
+as $$
+  select distinct i.corretor_id
+    from wa_contatos ct
+    join wa_conversas cv on cv.contato_id = ct.id
+    join wa_mensagens m  on m.conversa_id = cv.id and not coalesce(m.is_grupo, false)
+    join wa_instancias i on i.id = cv.instancia_id
+   where i.corretor_id is not null
+     and length(regexp_replace(coalesce(p_telefone,''), '\D', '', 'g')) >= 8
+     and right(regexp_replace(coalesce(ct.telefone,''), '\D', '', 'g'), 8)
+       = right(regexp_replace(coalesce(p_telefone,''), '\D', '', 'g'), 8);
+$$;
+
+comment on function public.f2_corretores_com_historico(text) is
+  'Corretores que ja trocaram mensagem de WhatsApp com este telefone, por qualquer instancia deles.';
+
+-- Copia de motor_proximo_sequencial com uma lista de exclusao. Mesma tabela de
+-- contadores, mesmo credito, mesma ordem -- carga e anuncio continuam girando
+-- na MESMA roda; a exclusao so tira candidatos desta rodada.
+create or replace function public.motor_proximo_sequencial_exceto(p_auto bigint, p_bloco text, p_excluir bigint[])
+returns bigint language plpgsql security definer set search_path to 'public'
+as $function$
+declare v_total numeric; v_id bigint; v_marcados int; v_exige boolean;
+        v_ex bigint[] := coalesce(p_excluir, '{}'::bigint[]);
+        v_sobra int;
+begin
+  perform pg_advisory_xact_lock(hashtext(coalesce(p_auto,0)::text||':'||coalesce(p_bloco,'_')));
+
+  v_exige := coalesce(public.distribuicao_exige_apto(p_auto, p_bloco), true);
+  select count(*) into v_marcados from public.distribuicao_marcados(p_auto, p_bloco);
+
+  if v_marcados > 0 then
+    update motor_roleta_contadores rc set peso = 0
+     where rc.automacao_id = p_auto and rc.bloco_id = p_bloco
+       and coalesce(rc.peso,0) > 0
+       and not exists (select 1 from public.distribuicao_marcados(p_auto, p_bloco) m
+                        where m.corretor_id = rc.corretor_id);
+    insert into motor_roleta_contadores(automacao_id, bloco_id, corretor_id, peso)
+    select p_auto, p_bloco, m.corretor_id, m.peso
+      from public.distribuicao_marcados(p_auto, p_bloco) m
+    on conflict (automacao_id, bloco_id, corretor_id) do update set peso = excluded.peso;
+  end if;
+
+  -- Sobrou alguem depois da exclusao? Se nao, a exclusao cai: lead entregue
+  -- para quem ja falou e melhor do que lead parado.
+  select count(*) into v_sobra
+    from motor_roleta_contadores rc join corretores c on c.id = rc.corretor_id
+   where rc.automacao_id = p_auto and rc.bloco_id = p_bloco
+     and coalesce(rc.peso,0) > 0 and coalesce(c.ativo,true)
+     and (not v_exige or public.corretor_pode_receber(c.id))
+     and not (rc.corretor_id = any(v_ex));
+  if v_sobra = 0 then v_ex := '{}'::bigint[]; end if;
+
+  select sum(rc.peso) into v_total
+    from motor_roleta_contadores rc join corretores c on c.id = rc.corretor_id
+   where rc.automacao_id = p_auto and rc.bloco_id = p_bloco
+     and coalesce(rc.peso,0) > 0 and coalesce(c.ativo,true)
+     and (not v_exige or public.corretor_pode_receber(c.id))
+     and not (rc.corretor_id = any(v_ex));
+  if coalesce(v_total,0) <= 0 then return null; end if;
+
+  update motor_roleta_contadores rc
+     set credito = rc.credito + rc.peso
+    from corretores c
+   where c.id = rc.corretor_id and rc.automacao_id = p_auto and rc.bloco_id = p_bloco
+     and coalesce(rc.peso,0) > 0 and coalesce(c.ativo,true)
+     and (not v_exige or public.corretor_pode_receber(c.id))
+     and not (rc.corretor_id = any(v_ex));
+
+  select rc.corretor_id into v_id
+    from motor_roleta_contadores rc join corretores c on c.id = rc.corretor_id
+   where rc.automacao_id = p_auto and rc.bloco_id = p_bloco
+     and coalesce(rc.peso,0) > 0 and coalesce(c.ativo,true)
+     and (not v_exige or public.corretor_pode_receber(c.id))
+     and not (rc.corretor_id = any(v_ex))
+   order by rc.credito desc, rc.recebidos asc, rc.corretor_id asc
+   limit 1;
+  if v_id is null then return null; end if;
+
+  update motor_roleta_contadores
+     set credito = credito - v_total, recebidos = recebidos + 1, atualizado_em = now()
+   where automacao_id = p_auto and bloco_id = p_bloco and corretor_id = v_id;
+
+  return v_id;
+end $function$;
+
+comment on function public.motor_proximo_sequencial_exceto(bigint, text, bigint[]) is
+  'Proximo da fila da automacao, pulando os corretores da lista. Se a exclusao esvaziar a fila, ela e ignorada -- lead parado e pior que segundo contato.';
+
+revoke execute on function public.f2_corretores_com_historico(text) from public, anon;
+revoke execute on function public.motor_proximo_sequencial_exceto(bigint, text, bigint[]) from public, anon;
diff --git a/supabase/migrations/20260813170300_carga_tick_com_voz_nova.sql b/supabase/migrations/20260813170300_carga_tick_com_voz_nova.sql
new file mode 100644
index 0000000..c60e872
--- /dev/null
+++ b/supabase/migrations/20260813170300_carga_tick_com_voz_nova.sql
@@ -0,0 +1,155 @@
+-- O TICK DA CARGA, agora com a regra da voz nova (ago/2026)
+--
+-- Substitui 20260813170100. A unica diferenca de comportamento e a chamada a
+-- motor_proximo_sequencial_exceto: quem ja trocou mensagem com o cliente sai da
+-- rodada. O motivo do desvio fica gravado em f2_carga_lead.motivo e no log de
+-- motor_execucoes, para a decisao ser auditavel depois.
+
+create or replace function public.f2_carga_tick(p_teto int default 6)
+returns jsonb language plpgsql security definer set search_path to 'public'
+as $function$
+declare
+  r record; v_auto bigint; v_bloco text;
+  v_lead bigint; v_neg bigint; v_cor bigint; v_nome text; v_card uuid;
+  v_tz text; v_h1 time; v_h2 time;
+  v_ja bigint[]; v_pulou text;
+  v_feitos int := 0; v_pulados int := 0; v_esperando int := 0; v_voz_nova int := 0;
+begin
+  select timezone, horario_oficial_inicio, horario_oficial_fim
+    into v_tz, v_h1, v_h2 from ncrm_operacao_config where id;
+  if not ((now() at time zone v_tz)::time >= v_h1 and (now() at time zone v_tz)::time < v_h2) then
+    return jsonb_build_object('ok', true, 'acao', 'fora da janela oficial');
+  end if;
+
+  select me.automacao_id, me.bloco_id into v_auto, v_bloco
+    from motor_execucoes me
+   where me.evento = 'distribuicao' and me.automacao_id is not null
+     and exists (select 1 from motor_roleta_contadores rc
+                  where rc.automacao_id = me.automacao_id and rc.bloco_id = me.bloco_id)
+   order by me.criado_em desc limit 1;
+  if v_auto is null then
+    return jsonb_build_object('ok', false, 'erro', 'sem_fila_configurada');
+  end if;
+
+  for r in
+    select * from f2_carga_lead
+     where distribuido_em is null and situacao = 'pendente'
+       and quando is not null and quando <= now()
+     order by quando, id
+     limit greatest(1, least(coalesce(p_teto, 6), 30))
+  loop
+    v_lead := null; v_neg := null; v_card := null; v_pulou := null;
+
+    -- DUPLICADO NAO DUPLICA: reaproveita o registro pelos 8 ultimos digitos, o
+    -- mesmo criterio que o resto do sistema usa para telefone (resolve DDI, DDD
+    -- e o nono digito de uma vez).
+    if length(r.telefone_dig) >= 8 then
+      select l.id into v_lead from leads l
+       where right(regexp_replace(coalesce(l.telefone,''), '\D', '', 'g'), 8) = right(r.telefone_dig, 8)
+       order by l.id desc limit 1;
+    end if;
+
+    -- JA TEM DONO OU JA ESTA NO FUNIL: fica de fora. A protecao do bloco
+    -- devolveria ao rodizio quem nao esta em venda/visita, mas mexer na
+    -- carteira de quem ja atende nao e o proposito desta carga.
+    if v_lead is not null and (
+         exists (select 1 from leads l where l.id = v_lead and l.corretor_id is not null)
+      or exists (select 1 from f2_lead f join negocios n on n.id = f.origem_negocio_id
+                  where n.lead_id = v_lead and f.descartado_em is null)
+    ) then
+      update f2_carga_lead
+         set situacao = 'pulado', distribuido_em = now(), lead_id = v_lead,
+             motivo = 'ja tem dono ou card ativo no Funil 2.0',
+             corretor_nome = (select c.nome from leads l join corretores c on c.id = l.corretor_id where l.id = v_lead)
+       where id = r.id;
+      v_pulados := v_pulados + 1;
+      continue;
+    end if;
+
+    -- VOZ NOVA: quem ja trocou mensagem com este cliente sai da rodada.
+    select coalesce(array_agg(x), '{}'::bigint[]) into v_ja
+      from f2_corretores_com_historico(r.telefone_dig) x;
+
+    v_cor := motor_proximo_sequencial_exceto(v_auto, v_bloco, v_ja);
+    if v_cor is null then
+      v_esperando := v_esperando + 1;
+      continue;
+    end if;
+    select nome into v_nome from corretores where id = v_cor;
+
+    if array_length(v_ja, 1) > 0 then
+      if v_cor = any(v_ja) then
+        -- a exclusao caiu porque nao sobrou ninguem apto sem historico
+        v_pulou := 'todos os aptos ja falaram com o cliente; a regra da voz nova foi ignorada nesta entrega';
+      else
+        v_voz_nova := v_voz_nova + 1;
+        v_pulou := 'pulou ' || (select string_agg(c.nome, ', ' order by c.nome)
+                                  from corretores c where c.id = any(v_ja))
+                   || ' — ja tinham conversa com este cliente';
+      end if;
+    end if;
+
+    if v_lead is null then
+      insert into leads (nome, telefone, email, origem, status, extras)
+      values (r.nome, r.telefone_dig, nullif(r.email,''), coalesce(r.origem, 'planilha'), 'novo',
+              coalesce(r.extras, '{}'::jsonb))
+      returning id into v_lead;
+    end if;
+
+    -- NEGOCIO no Funil 2.0: reaproveita aberto antes de criar. O negocio antigo
+    -- do Aquario, se houver, tambem recebe o dono -- senao o lead continuaria
+    -- aparecendo como disponivel para pesca depois de ja ter sido entregue.
+    select n.id into v_neg from negocios n
+     where n.lead_id = v_lead and n.pipeline_id = f2_pipeline_id() and n.status = 'aberto'
+     order by n.id desc limit 1;
+    if v_neg is null then
+      insert into negocios (lead_id, pipeline_id, stage_id, status, ultima_movimentacao, criado_em)
+      values (v_lead, f2_pipeline_id(),
+              (select s.id from pipeline_stages s where s.pipeline_id = f2_pipeline_id()
+                order by s.ordem nulls last, s.id limit 1),
+              'aberto', now(), now())
+      returning id into v_neg;
+    end if;
+
+    update leads    set corretor_id = v_cor where id = v_lead;
+    update negocios set corretor_id = v_cor where lead_id = v_lead and corretor_id is null;
+
+    -- O selo de aquario sai junto com a posse, como na pesca.
+    update leads
+       set tags = coalesce((select jsonb_agg(t) from jsonb_array_elements(tags) t
+                             where t->>'name' is distinct from 'Aquário'), '[]'::jsonb)
+     where id = v_lead and tags @> '[{"name":"Aquário"}]'::jsonb;
+
+    v_card := f2_entrada_direta(v_neg, 'novo');
+
+    insert into lead_dono_auditoria(lead_id, de, para, origem, quando)
+    values (v_lead, null, v_cor, 'carga_planilha:' || r.lote, now());
+
+    insert into motor_execucoes(automacao_id, automacao_nome, bloco_id, evento, status,
+                                lead_nome, lead_telefone, detalhe)
+    values (v_auto, 'Carga de planilha ' || r.lote, v_bloco, 'distribuicao',
+            case when v_card is null then 'alerta' else 'ok' end, r.nome, r.telefone_dig,
+            case when v_card is null
+                 then 'Lead da carga entregue a ' || coalesce(v_nome,'?') || ' — ATENCAO: card do Funil 2.0 nao foi criado'
+                 else 'Lead da carga entregue a ' || coalesce(v_nome,'?') || ' e card criado no Funil 2.0' end
+            || coalesce(' · ' || v_pulou, ''));
+
+    update f2_carga_lead
+       set situacao = 'distribuido', distribuido_em = now(), motivo = v_pulou,
+           lead_id = v_lead, negocio_id = v_neg, corretor_id = v_cor, corretor_nome = v_nome
+     where id = r.id;
+    v_feitos := v_feitos + 1;
+  end loop;
+
+  return jsonb_build_object('ok', true, 'distribuidos', v_feitos, 'pulados', v_pulados,
+                            'esperando_corretor_apto', v_esperando,
+                            'desviados_por_historico', v_voz_nova);
+end $function$;
+
+comment on function public.f2_carga_tick(int) is
+  'Distribui os leads da carga pela fila da automacao publicada, pulando corretor que ja trocou mensagem com o cliente. Destino: etapa novo / Primeira abordagem.';
+
+revoke execute on function public.f2_carga_tick(int) from public, anon;
+
+select cron.schedule('f2-carga-planilha', '* * * * *', 'select public.f2_carga_tick(6);')
+ where not exists (select 1 from cron.job where jobname = 'f2-carga-planilha');
