# Exemplo de variáveis do CRM Nova Era por AMBIENTE. NÃO contém segredos.
# STAGING: habilitar para validação com usuários autorizados.
# PRODUÇÃO: manter CRM_NOVA_ERA_ENABLED=false (não conectar nesta entrega).

# --- STAGING (exemplo) ---
NEXT_PUBLIC_CRM_NOVA_ERA_ENABLED=true
# Allowlist = ids de `usuarios` autorizados (separados por vírgula). Vazio = ninguém.
NEXT_PUBLIC_CRM_NOVA_ERA_ALLOWLIST=cccc0000-0000-4000-8000-000000000001

# --- PRODUÇÃO (referência; NÃO aplicar nesta entrega) ---
# NEXT_PUBLIC_CRM_NOVA_ERA_ENABLED=false
# NEXT_PUBLIC_CRM_NOVA_ERA_ALLOWLIST=
