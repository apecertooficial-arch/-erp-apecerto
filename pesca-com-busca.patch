+/* BUSCA NO AQUÁRIO PARA PESCAR — endpoint separado, pelo mesmo motivo da
+ * carteira antiga.
+ *
+ * O payload de /api/funil2 traz `aquario` com os 20 mais antigos, e era só isso
+ * que o modal de pesca tinha para oferecer. Só que o Aquário tem 11.669
+ * negócios disponíveis: na prática o corretor nunca conseguia pescar QUEM ele
+ * queria — só os mesmos 20 nomes que ele já tinha decidido não pescar.
+ *
+ * POR QUE NÃO CRESCER O PAYLOAD: mandar 11 mil nomes em toda carga da tela
+ * seriam megabytes por request, para um recurso que só é usado quando alguém
+ * abre o modal e digita. Aqui a consulta só acontece na busca.
+ *
+ * A visibilidade e o critério de disponibilidade são resolvidos dentro da
+ * função SQL — o mesmo critério de f2_pescar_negocio. Regra de acesso perto do
+ * dado é regra que a próxima porta não esquece de aplicar.
+ */
+import type { SupabaseClient } from "@supabase/supabase-js";
+import { createServerSupabaseClient } from "../../../lib/supabase/server";
+
+export const dynamic = "force-dynamic";
+
+export async function GET(request: Request) {
+  const header = request.headers.get("authorization");
+  const token = header?.startsWith("Bearer ") ? header.slice(7) : null;
+  if (!token) return Response.json({ error: "Sessão necessária." }, { status: 401 });
+  const db = createServerSupabaseClient(token);
+  const { data: user, error: authError } = await db.auth.getUser(token);
+  if (authError || !user.user) return Response.json({ error: "Sessão inválida ou expirada." }, { status: 401 });
+
+  const busca = (new URL(request.url).searchParams.get("q") ?? "").trim().slice(0, 80);
+  /* Diferente da carteira antiga, busca vazia aqui é legítima: é a lista
+     inicial do modal — os mais antigos, a água mais parada. O que não vale é
+     buscar por uma ou duas letras, que devolve meio Aquário sem ajudar. */
+  if (busca.length > 0 && busca.length < 3) return Response.json({ leads: [], curta: true });
+
+  /* Mesmo desvio de tipagem que /api/funil2 usa: database.types.ts é gerado e
+     ainda não conhece esta função. */
+  const rpc = db as unknown as SupabaseClient;
+  const { data, error } = await rpc.rpc("f2_aquario_buscar", { p_busca: busca || null, p_limite: 30 });
+  if (error) return Response.json({ error: error.message }, { status: 502 });
+  return Response.json({ leads: data ?? [], curta: false });
+}
